manifest {
    name            = 'cog-ball/01-counts'
    description     = 'COG B-ALL MD-ALL: FASTQ -> STAR -> HTSeq -> DUX4 patch gene counts'
    nextflowVersion = '>=24.10.0'
}

includeConfig '../conf/common.config'

timeline.file = "${params.outdir}/${params.center}/pipeline_info/counts_${new java.util.Date().format('yyyyMMdd-HHmm')}_timeline.html"
report.file   = "${params.outdir}/${params.center}/pipeline_info/counts_${new java.util.Date().format('yyyyMMdd-HHmm')}_report.html"
trace.file    = "${params.outdir}/${params.center}/pipeline_info/counts_${new java.util.Date().format('yyyyMMdd-HHmm')}_trace.tsv"
