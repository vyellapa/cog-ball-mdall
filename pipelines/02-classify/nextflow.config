manifest {
    name            = 'cog-ball/02-classify'
    description     = 'COG B-ALL MD-ALL: gene counts -> MD-ALL expression classifier (PhenoGraph + SVM)'
    nextflowVersion = '>=24.10.0'
}

includeConfig '../conf/common.config'

profiles {
    // MD-ALL's bundled test count files (gu-lab20/MD-ALL@3047c05); run test/fetch_test_data.sh first.
    // Declared before the report paths below so they see the test outdir.
    test {
        params.input  = "${projectDir}/../../test/data/classify_samplesheet.csv"   // test/fetch_test_data.sh
        params.center = 'TEST'
        params.outdir = "${launchDir}/results-test"
    }
}

timeline.file = "${params.outdir}/${params.center}/pipeline_info/classify_${new java.util.Date().format('yyyyMMdd-HHmm')}_timeline.html"
report.file   = "${params.outdir}/${params.center}/pipeline_info/classify_${new java.util.Date().format('yyyyMMdd-HHmm')}_report.html"
trace.file    = "${params.outdir}/${params.center}/pipeline_info/classify_${new java.util.Date().format('yyyyMMdd-HHmm')}_trace.tsv"
