// Shared by every COG B-ALL pipeline (00-reference, 01-counts, 02-classify).
// Included from each pipeline's nextflow.config.

params {
    pipeline_version  = new File("${projectDir}/../../VERSION").text.trim()

    // Defaults from the site settings file (site.conf in the repository folder, or the
    // file named by COG_BALL_SITE_CONF); command-line --center/--outdir/... still win.
    site_conf         = System.getenv('COG_BALL_SITE_CONF') ?: "${projectDir}/../../site.conf"
    center            = new File(System.getenv('COG_BALL_SITE_CONF') ?: "${projectDir}/../../site.conf").with { f -> f.exists() ? f.readLines().collect { l -> l.replaceAll(/#.*/, '').trim() }.find { l -> l.startsWith('CENTER=') }?.substring(7)?.trim() ?: null : null }
    outdir            = new File(System.getenv('COG_BALL_SITE_CONF') ?: "${projectDir}/../../site.conf").with { f -> f.exists() ? f.readLines().collect { l -> l.replaceAll(/#.*/, '').trim() }.find { l -> l.startsWith('OUTDIR=') }?.substring(7)?.trim() ?: null : null }
    refs              = new File(System.getenv('COG_BALL_SITE_CONF') ?: "${projectDir}/../../site.conf").with { f -> f.exists() ? f.readLines().collect { l -> l.replaceAll(/#.*/, '').trim() }.find { l -> l.startsWith('REFS=') }?.substring(5)?.trim() ?: null : null }

    // Where the images come from.
    //   registry: docker/OCI images "<registry>/<name>:<pipeline_version>"
    //   sif_dir:  directory of pre-built Singularity images
    //             "<sif_dir>/cog-ball-<name>_<pipeline_version>.sif" (takes precedence)
    registry          = 'cog-ball'
    sif_dir           = new File(System.getenv('COG_BALL_SITE_CONF') ?: "${projectDir}/../../site.conf").with { f -> f.exists() ? f.readLines().collect { l -> l.replaceAll(/#.*/, '').trim() }.find { l -> l.startsWith('SIF_DIR=') }?.substring(8)?.trim() ?: null : null }

    // Resource ceilings; process requests are capped to these.
    max_cpus          = 16
    max_memory        = '64.GB'
    max_time          = '48.h'

    // Slurm
    slurm_queue       = null
    slurm_options     = null
}

process {
    resourceLimits = [ cpus: params.max_cpus as int, memory: params.max_memory as nextflow.util.MemoryUnit, time: params.max_time as nextflow.util.Duration ]
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 1
    shell         = ['/bin/bash', '-euo', 'pipefail']

    withLabel: 'counts' {
        container = params.sif_dir ? "${params.sif_dir}/cog-ball-counts_${params.pipeline_version}.sif" : "${params.registry}/counts:${params.pipeline_version}"
    }
    withLabel: 'mdall' {
        container = params.sif_dir ? "${params.sif_dir}/cog-ball-mdall_${params.pipeline_version}.sif" : "${params.registry}/mdall:${params.pipeline_version}"
    }
}

profiles {
    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        singularity.enabled  = false
        apptainer.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getProperty('user.home')}/.singularity/cog-ball"
        docker.enabled         = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${System.getProperty('user.home')}/.apptainer/cog-ball"
        docker.enabled       = false
        singularity.enabled  = false
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = params.slurm_queue
        process.clusterOptions = params.slurm_options
        executor.queueSize     = 50
        executor.submitRateLimit = '10/1min'
    }
    local {
        process.executor = 'local'
    }
}

timeline.enabled = true
report.enabled   = true
trace.enabled    = true
trace.fields     = 'task_id,hash,name,status,exit,container,cpus,memory,realtime,%cpu,peak_rss,workdir'
