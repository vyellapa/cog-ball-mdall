manifest {
    name            = 'cog-ball/00-reference'
    description     = 'COG B-ALL MD-ALL: build the GRCh38 / Ensembl 102 / STAR reference bundle'
    nextflowVersion = '>=24.10.0'
}

includeConfig '../conf/common.config'

// The reference bundle goes to REFS from site.conf unless --outdir is given.
params.outdir = params.refs

timeline.file = "${params.outdir}/pipeline_info/reference_${new java.util.Date().format('yyyyMMdd-HHmm')}_timeline.html"
report.file   = "${params.outdir}/pipeline_info/reference_${new java.util.Date().format('yyyyMMdd-HHmm')}_report.html"
trace.file    = "${params.outdir}/pipeline_info/reference_${new java.util.Date().format('yyyyMMdd-HHmm')}_trace.tsv"
